# Data & experiment tracking artifacts
# data/* rather than data/, so the derived snapshot's .dvc pointer can be re-included:
# git cannot un-ignore a file whose parent directory is excluded.
data/*
!data/derived/
data/derived/*
!data/derived/*.dvc
# mlruns/* rather than mlruns/, so .gitkeep survives: the directory has to exist in a
# fresh clone, or the docker daemon creates it root-owned and mlflow-server cannot
# create mlflow.db inside it ("sqlite3.OperationalError: unable to open database file").
mlruns/*
!mlruns/.gitkeep
mlartifacts/
*.npz
*.db
inference/*
!inference/.gitkeep

# Models
*.keras
*.h5
*.onnx
*.pb

# Python
__pycache__/
*.py[cod]
.venv*/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Project-local Hermes skills
.hermes/
