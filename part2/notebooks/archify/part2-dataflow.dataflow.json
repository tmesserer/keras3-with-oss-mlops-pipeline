  "cards": [
    {
      "dot": "cyan",
      "title": "The split happens first",
      "items": [
        "fraudTrain.csv is the labelled history the model learns from",
        "fraudTest.csv is replayed live, so every request is new to the model"
      ]
    },
    {
      "dot": "violet",
      "title": "Two telemetry tables, on purpose",
      "items": [
        "scored_transactions is what the server did; app_requests is what the client experienced",
        "label-sync moves the uncertain rows to Label Studio and the verdicts back"
      ]
    },
    {
      "dot": "amber",
      "title": "What the human labels change",
      "items": [
        "A verdict adds a training row, removes a test row, and moves the dataset hash",
        "Those rows land in the validation slice: they move the threshold, not the weights"
      ]
    }
  ]
