# Copy to .env and set the ids that are specific to your machine:
#   cp .env.example .env
#   sed -i "s/^CONTAINER_UID=.*/CONTAINER_UID=$(id -u)/;s/^CONTAINER_GID=.*/CONTAINER_GID=$(id -g)/;\
#           s/^DOCKER_SOCK_GID=.*/DOCKER_SOCK_GID=$(stat -c '%g' /var/run/docker.sock)/" .env
#
# Both notebooks write this file for you on their first cell, so the lines above are
# only needed if you prefer to set it up by hand.

# The uid:gid every container runs as -- it fills `user:` in each compose service.
# Containers write into ./mlruns, ./data and ./inference on the host. Running them as you
# avoids root-owned files in your tree.
CONTAINER_UID=1000
CONTAINER_GID=1000

# Every compose file, merged in order. This is what lets a plain `docker compose
# --profile tools run --rm trainer` work from the repo root without -f flags.
# Order matters: later files override earlier ones.
COMPOSE_FILE=docker-compose.yml:compose.part1.yml:compose.part2.yml

# Postgres (Part 2): Label Studio's store, analyst verdicts, app telemetry.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=mlops

# Label Studio (Part 2, stage E). The account is created on first boot; the token is fixed
# so label-sync can authenticate without a human logging in first. Change all three if this
# ever leaves your laptop -- and note that changing LS_USERNAME/LS_PASSWORD afterwards does
# nothing, since bootstrap only runs against an empty database (docker volume rm lsdata).
LS_USERNAME=analyst@example.com
LS_PASSWORD=analyst123
LS_TOKEN=fraud-review-local-token-0001

# Airflow (Part 2, stage G). The retrain DAG starts a sibling trainer container through the
# docker socket, so the airflow container needs the group that owns that socket:
#   stat -c '%g' /var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock
DOCKER_SOCK_GID=986

# The image name and network the retrain DAG hands to the sibling trainer. Compose builds
# both; these two lines only tell the DAG what to ask for.
TRAINER_IMAGE=keras-mlops-fraud-trainer:latest
DOCKER_NETWORK=keras-mlops_default
